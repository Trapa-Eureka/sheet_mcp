{
  "name": "sheet-mcp",
  "version": "0.1.0",
  "description": "구글시트를 DB로 쓰는 필리핀 SME용 알림 발송 MCP 서버 (v0.1: 이메일, v0.2: SMS 예정)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-sheets",
    "email",
    "notifications",
    "claude"
  ],
  "license": "MIT",
  "author": "Trapa-Eureka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trapa-Eureka/sheet_mcp.git"
  },
  "homepage": "https://github.com/Trapa-Eureka/sheet_mcp#readme",
  "bugs": {
    "url": "https://github.com/Trapa-Eureka/sheet_mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sheet-mcp": "dist/server.js",
    "sheet-mcp-recover": "dist/cli/recoverStaleClaim.js"
  },
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "recover:stale-claim": "tsx src/cli/recoverStaleClaim.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^17.4.2",
    "googleapis": "^178.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
